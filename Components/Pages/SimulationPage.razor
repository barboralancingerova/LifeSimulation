@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject IJSRuntime JS // fullscreen

<div class="stranka">
    <div class="leva">
        <div class="hlavicka">
            <h3>
                Simulace
                @if (grid != null && grid.Statistics.History.Count > 0)
                {
                    <text>– Step #@grid.Statistics.History[^1].StepNumber</text>
                }
            </h3>
        </div>

        @if (grid != null)
        {
            <div class="mrizka"
                 style="grid-template-columns: repeat(@grid.Width, 1fr);
                        grid-template-rows: repeat(@grid.Height, 1fr);
                        aspect-ratio: @grid.Width / @grid.Height;">
                @for (int y = 0; y < grid.Height; y++)
                {
                    for (int x = 0; x < grid.Width; x++)
                    {
                        int cx = x, cy = y; //kopie souradnic
                        var occupant = grid.Cells[x, y].Occupant;
                        <div class="cell @CellBackground(grid.Cells[x, y]) @(vybrana == (cx, cy) ?"vybrana" : "")" @onclick="() => Microscope(cx, cy)">
                            @if (AnimalIconPath(occupant) is string path && path != "")
                            {
                                <img src="@path" alt="" />
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>

    <div class="prava">
        <div class="ovladani">
            <button class="ikona" @onclick="Start" disabled="@bezi"title="Start"> 
                <img src="/img/start.png" alt="Start" />
            </button>
            <button class="ikona" @onclick="Stop" disabled="@(!bezi)" title="Stop">
                <img src="/img/stop.png" alt="Stop" />
            </button>
            <button class="ikona" @onclick="NextStep" disabled="@bezi" title="Další krok">
                <img src="/img/next.png" alt="Další krok" />
            </button>
            <button class="ikona" @onclick="Reset" disabled="@ChancesInvalid"title="Reset">
                <img src="/img/restart.png" alt="Reset" />
            </button>
            <button class="ikona" @onclick="Fullscreen" title="⛶ Fullscreen">
                <img src="/img/fullscreen.png" alt="⛶ Fullscreen" />
            </button>
            </div>

        <div class="tweaky">
            <div class="inicializacni">
                <h4>Inicializace</h4>
                <button @onclick="PresetDefault">Rovnovážný poměr</button>
                <button @onclick="PresetRandom">Náhodný poměr</button>
                <button @onclick="PresetOverpredation">Přemnožení predátorů</button>
                <label>Producenti: <input type="number" min="0" max="1" step="0.001" @bind="producerChance" /></label>
                <label>Býložravci: <input type="number" min="0" max="1" step="0.001" @bind="herbivoreChance" /></label>
                <label>Predátoři: <input type="number" min="0" max="1" step="0.001" @bind="predatorChance" /></label>
                @if (ChancesInvalid)
                {
                    <p class="varovani">⚠ Součet pravděpodobností (@ChancesSum.ToString("0.###")) přesahuje 1!</p>
                }
                <label>Seed: <input type="number" @bind="seed" /></label>
                @* "mikroskop" *@
                @if (vybrana is (int vx, int vy) && grid != null)
                {
                    var cell = grid.Cells[vx, vy];
                    <div class="mikroskop">
                        <h5>Buňka [@vx, @vy]</h5>
                        @if (cell.Occupant is Organism o)
                        {
                            <p>@o.GetType().Name | E: @((o.Energy/o.EnergyMax*100).ToString("F1"))% | věk: @o.Age</p>
                            @* jeste neco? *@
                        }
                        else { <p>prázdno</p> }
                        @if (cell.Nutrients != null)
                        {
                            <p>Živiny: @cell.Nutrients.EnergyAmount.ToString("F1")</p>
                        }
                    </div>
                }
                </div>
            <div class="prubezne">
                <h4>Průběžné zásahy</h4>
                <label>Sluneční jas: @(grid?.Sunlight.EnergyAmount ?? 0)
                    <input type="range" min="0" max="@Config.SunlightMaxEnergy" step="0.1"
                        value="@(grid?.Sunlight.EnergyAmount ?? 0)"
                        @onchange="e => EditSunlight(double.Parse(e.Value!.ToString()!, System.Globalization.CultureInfo.InvariantCulture))" />
                    </label>
                <label>Rychlost: @stepsPerSec steps/s
                    <input type="range" min="1" max="15" value="@stepsPerSec"
                        @onchange="e => ChangeSpeed(int.Parse(e.Value!.ToString()!))" />
                    </label>
                <label>Efektivita predace: <input type="number" min="0" max="1" step="0.001" @bind="predationEfficiency" /></label>
                <label>Náklady na reprodukci: <input type="number" min="0" max="1" step="0.001" @bind="reproductionEnergyCost" /></label>
                <label>Náklady na pohyb: <input type="number" min="0" max="1" step="0.001" @bind="movementEnergyCost" /></label>
                <label>Bazální metabolismus: <input type="number" min="0" max="1" step="0.001" @bind="stepEnergyCost" /></label>
                <button @onclick="DefaultLifeParameters">Výchozí životní parametry</button>
                <button @onclick="RandomLifeParameters">Náhodné životní parametry</button>

                </div>

                @if (grid != null && grid.Statistics.History.Count > 0)
                {
                    var last = grid.Statistics.History[^1];
                    <p>Producers: @last.ProducerCount | Herbivores: @last.HerbivoreCount | Predators: @last.PredatorCount</p>
                }
                else
                {
                    <p>Zatím neproběhl jediný krok simulace.</p>
                }
                
            </div>

        <div class="grafika">
            <button @onclick="() => logScale = !logScale">Scale: @(logScale ? "log" : "lin")</button>

            <button class="legenda @(showProducers ? "" : "vypnuta")" @onclick="() => showProducers = !showProducers"> <span style="color:lime">●</span> Producenti </button>
            <button class="legenda @(showHerbivores ? "" : "vypnuta")" @onclick="() => showHerbivores = !showHerbivores"> <span style="color:gold">●</span> Býložravci </button>
            <button class="legenda @(showPredators ? "" : "vypnuta")" @onclick="() => showPredators = !showPredators"> <span style="color:red">●</span> Predátoři </button>
            <button class="legenda @(showEnergy ? "" : "vypnuta")" @onclick="() => showEnergy = !showEnergy"> <span style="color:cyan">●</span> Energie </button>
            <button class="legenda @(showSunlight ? "" : "vypnuta")" @onclick="() => showSunlight = !showSunlight"> <span style="color:white">●</span> Sluneční jas </button>
            <button class="legenda @(showAverageProducerEnergy ? "" : "vypnuta")" @onclick="() => showAverageProducerEnergy = !showAverageProducerEnergy"> <span style="color:green">●</span> Průměrná energie producentů </button>
            <button class="legenda @(showAverageHerbivoreEnergy ? "" : "vypnuta")" @onclick="() => showAverageHerbivoreEnergy = !showAverageHerbivoreEnergy"> <span style="color:orange">●</span> Průměrná energie býložravců </button>
            <button class="legenda @(showAveragePredatorEnergy ? "" : "vypnuta")" @onclick="() => showAveragePredatorEnergy = !showAveragePredatorEnergy"> <span style="color:darkred">●</span> Průměrná energie predátorů </button>
        </div>

        <div class="statistiky">
            @if (grid != null) { <Chart 
            History="grid.Statistics.History" 
            logScale="logScale" 
            ShowProducers="showProducers" 
            ShowHerbivores="showHerbivores" 
            ShowPredators="showPredators" 
            ShowEnergy="showEnergy" 
            ShowSunlight="showSunlight"
            ShowAverageProducerEnergy="showAverageProducerEnergy"
            ShowAverageHerbivoreEnergy="showAverageHerbivoreEnergy"
            ShowAveragePredatorEnergy="showAveragePredatorEnergy"
            /> }
        </div>
    </div>

    </div>

@code {
    // --- Stav komponenty ---
    private Grid? grid;
    private PeriodicTimer? timer;
    private bool bezi = false;
    private readonly object safetyLock = new();
    private bool logScale = true;
    private int stepsPerSec = 5;
    private int intervalMs = 200;
    private double producerChance = Config.ProducerChance;
    private double herbivoreChance = Config.HerbivoreChance;
    private double predatorChance = Config.PredatorChance;
    private double ChancesSum => producerChance + herbivoreChance + predatorChance;
    private bool ChancesInvalid => ChancesSum > 1;
    private bool showProducers = true;
    private bool showHerbivores = true;
    private bool showPredators = true;
    private bool showAverageProducerEnergy = true;
    private bool showAverageHerbivoreEnergy = true;
    private bool showAveragePredatorEnergy = true;
    private bool showEnergy = true;
    private bool showSunlight = true;
    private int seed = 29;
    private async Task Fullscreen() => await JS.InvokeVoidAsync("toggleFullscreen");
    private (int x, int y)? vybrana = null;
    private double predationEfficiency
    {
        get => RuntimeSettings.PredationEfficiency;
        set { lock (safetyLock) { RuntimeSettings.PredationEfficiency = value; } }
    }
    private double reproductionEnergyCost
    {
        get => RuntimeSettings.ReproductionEnergyCost;
        set { lock (safetyLock) { RuntimeSettings.ReproductionEnergyCost = value; } }
    }
    private double movementEnergyCost
    {
        get => RuntimeSettings.MovementEnergyCost;
        set { lock (safetyLock) { RuntimeSettings.MovementEnergyCost = value; } }
    }
    private double stepEnergyCost
    {
        get => RuntimeSettings.StepEnergyCost;
        set { lock (safetyLock) { RuntimeSettings.StepEnergyCost = value; } }
    }
    
    // --- Životní cyklus ---
    protected override void OnInitialized()
    {
        Grid.Rng = new Random(seed);
        grid = new Grid(Config.GridWidth, Config.GridHeight);
        grid.InitializePopulation(producerChance, herbivoreChance, predatorChance);
    }

    public void Dispose() => Stop();

    // --- Ovládání běhu ---
    private async Task Start()
    {
        if (bezi) return;
        bezi = true;
        timer = new PeriodicTimer(TimeSpan.FromMilliseconds(intervalMs));

        while (await timer.WaitForNextTickAsync())
        {
            lock (safetyLock)
            {
                grid?.Step();
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Stop()
    {
        timer?.Dispose();   // shodí i čekající WaitForNextTickAsync → smyčka skončí
        timer = null;
        bezi = false;
    }

    private void NextStep()
    {
        lock (safetyLock)
        {
            grid?.Step();
        }
    }

    private void Reset()
    {
        lock (safetyLock)
        {
            Stop();
            Grid.Rng = new Random(seed);

            OnInitialized(); 
        }
    }

    private void ChangeSpeed(int value)
    {
        stepsPerSec = value;
        intervalMs = 1000 / stepsPerSec;
        if (bezi) 
        { 
            Stop();
            _ = Start(); // restart timeru
        }    
    }

    // Control Panel
    private void EditSunlight(double value)
    {
        lock (safetyLock)
        {
            grid?.Sunlight.UpdateEnergy(value);
        }
    }

    //chances
    private void SetChances(double producerChance, double herbivoreChance, double predatorChance)
    {
        this.producerChance = producerChance;
        this.herbivoreChance = herbivoreChance;
        this.predatorChance = predatorChance;
        Reset();
    }

    private void PresetDefault()
    {
        SetChances(Config.ProducerChance, Config.HerbivoreChance, Config.PredatorChance);
    }

    private void PresetRandom()
    {
        var random = new Random();
        double p = random.NextDouble(), h = random.NextDouble(), pr = random.NextDouble();
        double sum = p + h + pr;
        double scale = random.NextDouble() * 0.6 / sum;   // hustota 0-60%
        SetChances(p * scale, h * scale, pr * scale);
    }
    private void PresetOverpredation()
    {
        SetChances(0.2, 0.05, 0.02);
    }

    private void ChangeProducerChance(double value) => producerChance = value;
    private void ChangeHerbivoreChance(double value) => herbivoreChance = value;
    private void ChangePredatorChance(double value) => predatorChance = value;
   
    // life parameters
    private void DefaultLifeParameters()
    {
        lock (safetyLock)
        {
            predationEfficiency = Config.PredationEfficiency;
            reproductionEnergyCost = Config.ReproductionEnergyCost;
            movementEnergyCost = Config.MovementEnergyCost;
            stepEnergyCost = Config.StepEnergyCost;
        }
    }

    private void RandomLifeParameters()
    {
        var random = new Random();
        lock (safetyLock)
        {
            predationEfficiency = Config.PredationEfficiency * (0.5 + random.NextDouble() * 1.5);  // pul az dvojansobek defaultu
            reproductionEnergyCost = Config.ReproductionEnergyCost * (0.5 + random.NextDouble() * 1.5);
            movementEnergyCost = Config.MovementEnergyCost * (0.5 + random.NextDouble() * 1.5);
            stepEnergyCost = Config.StepEnergyCost * (0.5 + random.NextDouble() * 1.5); 
        }
    }

    //Mikroskop
    private void Microscope(int x, int y)
    {
        vybrana = (x, y);
        lock (safetyLock)
        {
            Grid.Tracked = grid?.Cells[x, y].Occupant;   // choose to track
        }
    }

    // other
    private string CellBackground(Cell cell) 
    {
        if (cell.Nutrients != null) 
        {
            double e = cell.Nutrients.EnergyAmount;
            return e > Config.NutrientHighTreshold ? "nutrient-high" 
            : e > Config.NutrientMediumTreshold ? "nutrient-medium" 
            : "nutrient-low";
        }

        return cell.Occupant switch
        {
            Producer  => "producer",
            Herbivore => "herbivore",
            Predator  => "predator",
            _         => ""
        };
    }

    private string AnimalIconPath(Organism? occupant) 
    {
        return occupant switch
        {
            Producer  => "/img/producer.png",
            Herbivore => "/img/herbivore.png",
            Predator  => "/img/predator.png",
            _         => ""
        };
    }
}
